# ==============================================================================
# FACTUGRAFÍA - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# Clave de API de Google Gemini (Obtener gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Opcional: Secret para proteger el endpoint /api/analizar-factura de llamadas no autorizadas
# Si se deja vacío, el endpoint procesará peticiones locales o de desarrollo sin requerir x-api-key
FACTUGRAFIA_API_SECRET=
