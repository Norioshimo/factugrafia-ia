# ==============================================================================
# FACTUGRAFÍA - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# Clave de API de Google Gemini (crear gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Clave de API de Groq (crear gratis en https://console.groq.com/keys)
# Necesaria solo si usas el modelo de Groq (los PDF se convierten a imagen automáticamente)
GROQ_API_KEY=tu_groq_api_key_aqui

# Opcional: Secret para proteger el endpoint /api/analizar-factura de llamadas no autorizadas
# Si se deja vacío, el endpoint procesará peticiones locales o de desarrollo sin requerir x-api-key
FACTUGRAFIA_API_SECRET=
